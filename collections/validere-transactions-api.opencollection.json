          "info": {
            "name": "List All Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.validere.io/transactions",
            "params": [
              {
                "name": "filter_out_file_uploads",
                "value": "",
                "type": "query"
              },
              {
                "name": "dataset_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "submitted_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "submitted_before",
                "value": "",
                "type": "query"
              },
              {
                "name": "step",
                "value": "",
                "type": "query"
              },
              {
                "name": "source",
                "value": "",
                "type": "query"
              },
              {
                "name": "bucket",
                "value": "",
                "type": "query"
              },
              {
                "name": "file_key",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "only_latest",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of transactions submitted to the Data Platform\n\nThe following fields should be passed as query parameters:\n\n* `submitted_after` (datetime) - Optional, otherwise defaults to 1 week before current datetime. Required in isoformat i.e. %Y-%m-%dT%H:%M:%S%Z\n* `submitted_before` (datetime) -  Optional, otherwise defaults to current datetime. Required in isoformat i.e. %Y-%m-%dT%H:%M:%S%Z"
        },
        {
          "info": {
            "name": "Get Transaction By Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.validere.io/transactions/:transaction_id",
            "params": [
              {
                "name": "transaction_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "history",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Fetches details/status of a transaction based on its UUID."
        },
        {
          "info": {
            "name": "Download Transaction File Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.validere.io/transactions/:transaction_id/download",
            "params": [
              {
                "name": "transaction_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "error_only",
                "value": "",
